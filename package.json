    "@mui/x-date-pickers": "^6.19.6",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.10",
    "firebase": "^10.3.0",
    "firebaseui": "^6.1.0",
    "gh-pages": "^1.1.0",
    "graceful-fs": "^4.2.11",
    "history": "^4.7.2",
    "i18next": "^19.9.2",
