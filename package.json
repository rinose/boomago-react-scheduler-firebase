    "node-less-chokidar": "^0.1.2",
    "npm-run-all": "^4.1.2",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-big-calendar": "^1.11.1",
    "react-dnd": "^7.4.5",
    "react-dnd-html5-backend": "^7.4.4",
